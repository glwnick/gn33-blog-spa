# ---------------------------------------------------------------------------
# gn33-shop-spa environment variables. Copy to `.env` and adjust.
# Vite only exposes variables prefixed with VITE_ to the client.
# ---------------------------------------------------------------------------

# Base URL of the gn33-shop-app backend API. Port 8090 rather than 8080: gn33 runs on 8080 and both
# projects have to be able to run side by side. Matches gn33-shop-app/.env.example.
VITE_APP_API_URL=http://localhost:8090

# Enable client-side API mocking ("true" / "false")
VITE_APP_ENABLE_API_MOCKING=false

# Environment ("dev" enables dev-only behaviour)
VITE_APP_ENV=dev

# JWT issuer (must match the backend's JWT_ISSUER)
VITE_APP_ISSUER=gn33
