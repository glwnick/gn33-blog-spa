# Installed and built inside the image
node_modules
dist
dist-ssr
coverage

# Secrets and deployment scratch. Nothing environment-specific may enter the build context - the image
# is configured at runtime through /config.js, not at build time.
.env
.env.*
truenas.txt
comands.txt

