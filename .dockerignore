.gitignore
.vscode
.claude
.agents
.tanstack
skills-lock.json
.cta.json

# Docs and lint config - not needed to build (tsconfig.json is, since `pnpm build` runs tsc)
*.md
.prettierignore
prettier.config.js
eslint.config.js
Dockerfile
.dockerignore
.github
